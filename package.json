{
  "name": "johnsonandsebhanpc-org",
  "version": "0.1.0",
  "description": "A modern platform for managing organizational operations and NPC interactions",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "ts-node src/server/index.ts",
    "build": "tsc && vite build",
    "build:api": "tsc src/server",
    "preview": "vite preview",
    "start": "node dist/server/index.js",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "@tanstack/react-query": "^4.29.0",
    "@tanstack/react-router": "^1.0.0",
    "axios": "^1.4.0",
    "zustand": "^4.3.0",
    "zod": "^3.22.0",
    "react-hook-form": "^7.45.0",
    "classnames": "^2.3.2",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "typescript": "^5.1.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "vite": "^4.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.24",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.43.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint-config-prettier": "^8.8.0",
    "prettier": "^2.8.8",
    "vitest": "^0.33.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/user-event": "^14.4.3",
    "@vitest/coverage-c8": "^0.33.0"
  },
  "optionalDependencies": {
    "express": "^4.18.2",
    "@prisma/client": "^5.0.0",
    "prisma": "^5.0.0",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3"
  },
  "keywords": [
    "npc",
    "organization",
    "management",
    "platform",
    "react",
    "typescript",
    "web-app"
  ],
  "author": "sikh3nt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sikh3nt/johnsonandsebhanpc-org.git"
  },
  "bugs": {
    "url": "https://github.com/sikh3nt/johnsonandsebhanpc-org/issues"
  },
  "homepage": "https://github.com/sikh3nt/johnsonandsebhanpc-org#readme"
}
